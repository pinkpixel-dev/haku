{
  "name": "@pinkpixel/haku",
  "version": "1.0.0",
  "description": "Draw lofi music from the terminal or an AI agent. The Haku CLI and MCP server.",
  "keywords": [
    "lofi",
    "music",
    "mcp",
    "mcp-server",
    "ai-agents",
    "cli",
    "midi",
    "generative-music",
    "tone.js"
  ],
  "license": "Apache-2.0",
  "author": "Pink Pixel <admin@pinkpixel.dev> (https://pinkpixel.dev)",
  "homepage": "https://github.com/pinkpixel-dev/haku#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkpixel-dev/haku.git",
    "directory": "apps/agent"
  },
  "bugs": {
    "url": "https://github.com/pinkpixel-dev/haku/issues"
  },
  "type": "module",
  "bin": {
    "haku": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @haku/web build && tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tonejs/midi": "^2.0.28",
    "commander": "^15.0.0",
    "node-web-audio-api": "^2.2.0",
    "tone": "^15.1.22",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@haku/audio": "workspace:*",
    "@haku/core": "workspace:*",
    "@haku/protocol": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.4"
  }
}
